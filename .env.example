# =====================================================================
# MẪU khai biến môi trường — KHÔNG điền giá trị thật vào file này.
#
# Giá trị thật khai ở: Netlify → Site configuration → Environment variables
# (hoặc file .env trên máy khi chạy `netlify dev` — .env đã bị .gitignore).
#
# Vì sao: file này nằm trong Git, ai xem repo cũng đọc được.
# =====================================================================

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role key — toàn quyền ghi DB. CHỈ dùng trong Netlify Functions.
# Tuyệt đối không đưa vào HTML hay JavaScript chạy trên trình duyệt.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dịch vụ đối soát VietQR: khai bên nào đang dùng, để trống bên còn lại ---
SEPAY_WEBHOOK_KEY=
CASSO_WEBHOOK_KEY=
PAYOS_CHECKSUM_KEY=

# --- Link tài liệu mở sau khi khách trả tiền (link ký hạn hoặc Drive hạn chế) ---
DOC_URL_ONLINE=
DOC_URL_USB=

# --- Mã truy cập trang theo dõi (admin.html) ---
ADMIN_PASSCODE=

# --- HubSpot: Portal ID và Form GUID đều là mã công khai, không phải khoá bí mật ---
HUBSPOT_PORTAL_ID=247614091
HUBSPOT_REGION=na2
HUBSPOT_FORM_DONHANG=

# =====================================================================
# GỬI EMAIL — 3 luật tự động (xem netlify/functions/_lib/mail.js)
#
# Dùng Resend. Một tài khoản lo hai việc:
#   1. RESEND_API_KEY dưới đây  → 3 luật tự động của FiTop
#   2. SMTP cùng tài khoản      → Supabase Auth (link đăng nhập), khai
#      riêng trong Supabase Dashboard, KHÔNG khai ở đây:
#         Host  smtp.resend.com     Cổng  465
#         User  resend              Pass  chính khoá API này
# =====================================================================

# Khoá API Resend. Thiếu khoá này thì KHÔNG gửi email nào, nhưng web và
# thanh toán vẫn chạy bình thường — các luật tự động im lặng bỏ qua.
RESEND_API_KEY=

# Tên và địa chỉ người gửi. Địa chỉ phải thuộc tên miền đã xác thực ở Resend.
MAIL_FROM=FiTop Retreat <no-reply@fitop.com.vn>

# Hộp thư thật để khách bấm Trả lời là tới được người. Để trống thì email
# không có reply-to, khách liên hệ qua Zalo in trong thư.
MAIL_REPLY_TO=

# Nơi nhận thư báo nội bộ: bản sao đơn đã thanh toán + thông báo lead mới.
MAIL_ADMIN=info@fitop.com.vn

# --- Luật 2: nhắc đơn còn treo (netlify/functions/nhac-don-treo.js) ---
# Nhắc sau bao nhiêu giờ kể từ lúc tạo đơn
NHAC_SAU_GIO=24
# Quá bao nhiêu giờ thì thôi không nhắc nữa (mặc định 168 giờ = 7 ngày)
NHAC_BO_SAU_GIO=168
# Trần số thư mỗi lần quét, chặn vượt hạn mức Resend
NHAC_TOI_DA_MOI_LAN=40

# --- Tài khoản nhận tiền in trong thư nhắc (đang công khai trên web) ---
BANK_BIN=970432
BANK_ACC=92779
BANK_NAME=CONG TY TNHH TU VAN VA DICH VU FITOP
BANK_LABEL=VPBank
