# =====================================================================
# MẪU khai biến môi trường — KHÔNG điền giá trị thật vào file này.
#
# Giá trị thật khai ở: Netlify → Site configuration → Environment variables
# (hoặc file .env trên máy khi chạy `netlify dev` — .env đã bị .gitignore).
#
# Vì sao: file này nằm trong Git, ai xem repo cũng đọc được.
# =====================================================================

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role key — toàn quyền ghi DB. CHỈ dùng trong Netlify Functions.
# Tuyệt đối không đưa vào HTML hay JavaScript chạy trên trình duyệt.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dịch vụ đối soát VietQR: khai bên nào đang dùng, để trống bên còn lại ---
SEPAY_WEBHOOK_KEY=
CASSO_WEBHOOK_KEY=
PAYOS_CHECKSUM_KEY=

# --- Link tài liệu mở sau khi khách trả tiền (link ký hạn hoặc Drive hạn chế) ---
DOC_URL_ONLINE=
DOC_URL_USB=
